------------------------------
-- CORE LOGIC (الحماية)
------------------------------

local function nukeRemote()
	for _, obj in ipairs(Rep:GetDescendants()) do
		if obj:IsA("RemoteEvent") and obj.Name:lower():find("executeclientcommand") then
			obj:Destroy()
		end
	end
end

Rep.DescendantAdded:Connect(function(obj)
	if enabled and obj:IsA("RemoteEvent") and obj.Name:lower():find("executeclientcommand") then
		obj:Destroy()
	end
end)

local function isBlocked(name)
	name = name:lower()
	for _, w in ipairs(blockedWords) do
		if name:find(w, 1, true) then
			return true
		end
	end
	return false
end

local function blockGui(gui)
	if enabled and gui ~= sg and isBlocked(gui.Name) then
		if not countedBlocks[gui] then
			blocks += 1
			counter.Text = "المحظورات: " .. blocks
			countedBlocks[gui] = true
		end
		gui:Destroy()
	end
end

pgui.ChildAdded:Connect(function(c)
	task.defer(function()
		blockGui(c)
	end)
end)

local function scanAllGuis()
	if enabled then
		for _, g in ipairs(pgui:GetChildren()) do
			blockGui(g)
		end
	end
end

toggle.MouseButton1Click:Connect(function()
	enabled = not enabled

	if enabled then  
		toggle.Text = "تعطيل الحماية"  
		toggle.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
		status.Text = "الحالة: مفعلة"  
		status.TextColor3 = Color3.fromRGB(90, 255, 120)  
		nukeRemote()  
		scanAllGuis()
	else  
		toggle.Text = "تشغيل الحماية"  
		toggle.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		status.Text = "الحالة: معطلة"  
		status.TextColor3 = Color3.fromRGB(255, 80, 80)  
	end
end)

